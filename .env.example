# Copy this file to .env and fill it in. Never commit .env.

# ── Docker (read by compose.yaml) ───────────────────────────────
# Your movie folder on the host. Mounted read-only at /media in the container.
#   Docker Desktop on Windows: E:/Movies
#   Docker inside WSL:         /mnt/e/Movies
MEDIA_PATH=

# Port to open on the host. Defaults to 3000.
# CYRA_PORT=3000

# ── Docker and local dev ────────────────────────────────────────
# TMDB "API Read Access Token" (the long v4 token), not the short v3 API key.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Signs login tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Local dev only (npm run start:dev) ──────────────────────────
# Folder the app reads directly. Docker ignores this (the image uses /media).
MEDIA_DIR=

# Optional, shown with their defaults.
# PORT=3000
# DB_PATH=data/media.db