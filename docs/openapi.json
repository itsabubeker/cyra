  "info": {
    "title": "Cyra",
    "description": "Crya Api docs",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "JobProgressDto": {
        "type": "object",
        "properties": {
          "done": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "done",
          "total"
        ]
      },
      "JobDto": {
        "type": "object",
        "properties": {
          "finishedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "progress": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/JobProgressDto"
              }
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/ScannerResponseDto"
              },
              {
                "$ref": "#/components/schemas/MatchAllResponseDto"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "scan",
              "matchall"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "finishedAt",
          "progress",
          "error",
          "result",
          "id",
          "kind",
          "status",
          "startedAt"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "statusCode",
          "error"
        ]
      },
      "MovieListItemDto": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number",
            "nullable": true
          },
          "posterPath": {
            "type": "string",
            "nullable": true,
            "description": "TMDB image path, e.g. /abc.jpg (not a full URL). Build the URL as https://image.tmdb.org/t/p/{size}{posterPath}; w342 for grids, w780 for the movie page"
          },
          "id": {
            "type": "number"
          },
          "tmdbId": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "watched": {
            "type": "boolean"
          }
        },
        "required": [
          "year",
          "posterPath",
          "id",
          "tmdbId",
          "title",
          "watched"
        ]
      },
      "PaginatedMoviesDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieListItemDto"
            }
          },
          "page": {
            "type": "number"
          },
          "size": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ]
      },
      "Movie": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaFile"
            }
          },
          "id": {
            "type": "number"
          },
          "tmdbId": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "number",
            "nullable": true
          },
          "posterPath": {
            "type": "string",
            "nullable": true
          },
          "overview": {
            "type": "string",
            "nullable": true
          },
          "tagline": {
            "type": "string",
            "nullable": true
          },
          "runtime": {
            "type": "number",
            "nullable": true
          },
          "backdropPath": {
            "type": "string",
            "nullable": true
          },
          "voteAverage": {
            "type": "number",
            "nullable": true
          },
          "voteCount": {
            "type": "number",
            "nullable": true
          },
          "imdbId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "files",
          "id",
          "tmdbId",
          "title",
          "year",
          "posterPath",
          "overview",
          "tagline",
          "runtime",
          "backdropPath",
          "voteAverage",
          "voteCount",
          "imdbId"
        ]
      },
      "MediaFile": {
        "type": "object",
        "properties": {
          "movie": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Movie"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "relativePath": {
