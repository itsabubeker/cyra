import { Controller, Get, Param, ParseIntPipe, Query } from '@nestjs/common';
import { MoviesService } from './movies.service.js';
import { ListMoviesQueryDto } from './dto/list-movies-query.dto.js';

@Controller('movies')
export class MoviesController {
  constructor(private readonly moviesService: MoviesService) {}

  @Get()
  async findAll(@Query() query: ListMoviesQueryDto) {
    const result = await this.moviesService.findAll(query);

    return {
      items: result[0],
      page: query.page,
      limit: query.limit,
      total: result[1],
    };
  }

  @Get(':id')
  findOne(@Param('id', ParseIntPipe) id: number) {
    return this.moviesService.findOne(id);
  }
}
</file>

<file path="src/movies/movies.service.ts">
import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Movie } from './entities/movie.entity.js';
import { FindOptionsWhere, Like, Repository } from 'typeorm';
import { ListMoviesQueryDto } from './dto/list-movies-query.dto.js';

@Injectable()
export class MoviesService {
  constructor(
    @InjectRepository(Movie)
    private readonly movies: Repository<Movie>,
  ) {}

  findAll({ search, year, limit, page }: ListMoviesQueryDto) {
    const where: FindOptionsWhere<Movie> = {};
    if (search) where.title = Like(`%${search}%`);
    if (year) where.year = year;

    return this.movies.findAndCount({
      order: { title: 'ASC', id: 'ASC' },
      where,
      take: limit,
      skip: limit * (page - 1),
    });
  }

  async findOne(id: number) {
    const movie = await this.movies.findOne({
      where: { id },
      relations: { files: true },
    });
    if (!movie) throw new NotFoundException(`Movie with ID ${id} not found `);
    return movie;
  }
}
</file>

